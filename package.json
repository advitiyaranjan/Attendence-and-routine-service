{
  "name": "student-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @student-os/server\" \"npm run dev -w @student-os/web\"",
    "dev:web": "npm run dev -w @student-os/web",
    "dev:server": "npm run dev -w @student-os/server",
    "build": "npm run build -w @student-os/server && npm run build -w @student-os/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}

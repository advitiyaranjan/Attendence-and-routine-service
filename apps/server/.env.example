# Copy to apps/server/.env
DATABASE_URL=postgresql://student_os:student_os@localhost:5432/student_os
# At least 32 random characters in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-in-production
# Comma-separated browser origins allowed to call the API (not needed in dev; Vite proxies /api)
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Google Gemini — server-side only, never exposed to the browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used in order when the primary model is overloaded (503) or rate limited
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Optional: Google sign-in (OAuth client ID of type "Web application")
GOOGLE_CLIENT_ID=

# Allow AI features without an account (rate-limited per IP)
AI_ALLOW_GUEST=true
AI_DAILY_LIMIT=200

# Web Push (reminders when the app is closed). Generate a key pair once:
#   npm run vapid -w @student-os/server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Set to false on extra server instances if you only want one sending pushes (duplicates are prevented either way)
PUSH_SCHEDULER=true
